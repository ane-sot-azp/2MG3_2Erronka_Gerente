<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Pantailak.EguraldiaController"
            style="-fx-background-color: #F5F5F5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 14 18; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <Label text="Eguraldia" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button onAction="#closeWindow"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 6;">
                <graphic>
                    <SVGPath content="M18 6L6 18M6 6l12 12"
                             style="-fx-stroke: #4a5568; -fx-stroke-width: 2.5; -fx-fill: transparent;"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox spacing="18" style="-fx-padding: 24;">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="2">
                    <Label text="Gaurko eta hurrengo egunetako iragarpena" style="-fx-text-fill: #C19A6B; -fx-font-size: 16;"/>
                </VBox>
            </HBox>

            <Label fx:id="lblHiria" text="Udalerria - Probintzia" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1D505B;"/>

            <ScrollPane fitToWidth="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <content>
                    <FlowPane fx:id="pnlEgunak"
                              hgap="18"
                              vgap="18"
                              prefWrapLength="1200"
                              style="-fx-padding: 6;"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
